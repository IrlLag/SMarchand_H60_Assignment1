@model Product

@functions {
    private IHtmlHelper<Product> _html;
    private IJsonHelper _json;
    private IViewComponentHelper _component;
    private IUrlHelper _url;
    private IModelExpressionProvider _modelExpressionProvider;
}

@{
    ViewData["Title"] = "Edit";
}

<h1>Change Stock</h1>

<h4>Product</h4>
<hr/>
<div class="row">
    <div class="col-md-4">

        <div class="text-danger">@ViewData["ErrorMessage"]</div>
        <input type="hidden" value="@ViewData["ProductId"]" />
        <div class="form-group">
            <label asp-for="Stock" class="control-label"></label>
            <input asp-for="Stock" class="form-control"/>
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary"/>
        </div>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}