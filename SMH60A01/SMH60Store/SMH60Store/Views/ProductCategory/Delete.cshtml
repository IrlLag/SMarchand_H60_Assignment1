@model SMH60Store.Models.ProductCategory

@{
    ViewData["Title"] = "Delete";
}

<h1 class="subpage-title">Delete</h1>

<p>Are you sure you want to delete this? All related products along with their respective relationships will also be deleted.</p>
<div>
    <div class="deletediv">
        <div class="deleteitem">
            <h3 >
                @Html.DisplayNameFor(model => model.ProdCatId)
            </h3>
            <p>
                @Html.DisplayFor(model => model.ProdCatId)
            </p>
        </div>

        <div class="deleteitem">
            <h3 >
                @Html.DisplayNameFor(model => model.ProdCat)
            </h3>
            <p>
                @Html.DisplayFor(model => model.ProdCat)
            </p>
        </div>

        <div class="deleteitem">
            <h3>
                @Html.DisplayNameFor(model => model.Products)
            </h3>
            <p>
                @Html.DisplayFor(model => model.Products)
            </p>
        </div>

        
    </div>
    <form asp-action="Delete" class="deleteform">
        <input type="hidden" asp-for="ProdCatId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index">Back to List</a>
    </form>
</div>
