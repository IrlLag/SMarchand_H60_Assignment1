@model SMH60Store.Models.ProductCategory

@{
    ViewData["Title"] = "Details";
}

<h1 class="subpage-title">Details</h1>

<div>

    <dl class="detaildiv">
        <dt class = "detailitemname">
            @Html.DisplayNameFor(model => model.ProdCat)
        </dt>
        <dd class = "detailitem">
            @Html.DisplayFor(model => model.ProdCat)
        </dd>
    <dt class = "detailitemname">
        @Html.DisplayNameFor(model => model.Products)
    @if (Model.Products.Any())
    {
        <ul class="detailitem">
            @foreach (var product in Model.Products)
            {
                <li class="detaillistitem">@product.Description</li>
            }
        </ul>
    }
    else
    {
        <p>There are no products in this category :(</p>
    }
    </dl>
</div>
<div class="linkdiv">
    <a asp-action="Edit" asp-route-prodcatid="@Model?.ProdCatId">Edit</a> 
    <a asp-action="Index">Back to List</a>
</div>
