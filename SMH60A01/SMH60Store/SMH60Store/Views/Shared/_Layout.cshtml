@functions {
    private IHtmlHelper<dynamic> _html;
    private IJsonHelper _json;
    private IViewComponentHelper _component;
    private IUrlHelper _url;
    private IModelExpressionProvider _modelExpressionProvider;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - SMH60Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/SMH60Store.styles.css" asp-append-version="true"/>
</head>
<body>
<div class="mainstore">
<header>
    <nav>
        <div class="navbar">
            <a class="titlelink headerlink" asp-area="" asp-controller="Home" asp-action="Index">Lag's Digital Emporium</a>
        </div>
        <div class="navbar navbar-list-div">
            <ul class="navbar-list">
                <li>
                    <a class="headerlink" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a class="headerlink" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                </li>
                <li>
                    <a class="headerlink" asp-area="" asp-controller="ProductCategory" asp-action="Index">Product Categories</a>
                </li>
            </ul>
        </div>
    </nav>
</header>

    <main role="main" >
        @RenderBody()
    </main>
</div>

<footer>
    <span></span>
    <div>
        &copy; 2026 - Lag's Digital Emporium' - <a asp-area="" asp-controller="Products" asp-action="Index">Products</a> - <a asp-area="" asp-controller="ProductCategory" asp-action="Index">Categories</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>